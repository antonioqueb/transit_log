<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Menú raíz -->
    <menuitem id="menu_transit_root"
              name="Tránsitos"
              sequence="10"/>

    <!-- Acción -->
    <record id="action_transit_log" model="ir.actions.act_window">
        <field name="name">Bitácora de Tránsitos</field>
        <field name="res_model">transit.log</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p>Registra cada movimiento directo a destino sin afectar inventario.</p>
        </field>
    </record>

    <!-- Menú secundario -->
    <menuitem id="menu_transit_log"
              name="Bitácora"
              parent="menu_transit_root"
              action="action_transit_log"
              sequence="20"/>

    <!-- Vista lista -->
    <record id="view_transit_log_list" model="ir.ui.view">
        <field name="name">transit.log.list</field>
        <field name="model">transit.log</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="date_start"/>
                <field name="origin"/>
                <field name="destination"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <!-- Vista formulario -->
    <record id="view_transit_log_form" model="ir.ui.view">
        <field name="name">transit.log.form</field>
        <field name="model">transit.log</field>
        <field name="arch" type="xml">
            <form string="Bitácora de Tránsito" create="true" edit="true">
                <header>
                    <!-- Botón SALIR sólo visible en borrador -->
                    <button name="action_start" type="object" string="Salir"
                            modifiers="{'invisible': [['state','!=','draft']]}"/>

                    <!-- Botón LLEGADA sólo visible en tránsito -->
                    <button name="action_arrive" type="object" string="Llegada"
                            modifiers="{'invisible': [['state','!=','in_transit']]}"/>

                    <!-- Botón CANCELAR visible en borrador y tránsito -->
                    <button name="action_cancel" type="object" string="Cancelar"
                            modifiers="{'invisible': [['state','in',['delivered','cancelled']]]}"/>

                    <!-- Barra de estados -->
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,in_transit,delivered,cancelled"
                           modifiers="{}"/>
                </header>

                <sheet>
                    <group>
                        <field name="name" readonly="1"/>
                        <field name="origin"/>
                        <field name="destination"/>
                        <field name="date_start"/>
                        <field name="date_end"
                               modifiers="{'invisible': [['state','!=','delivered']]}"/>
                    </group>

                    <notebook>
                        <page string="Productos">
                            <field name="line_ids" mode="list,form">
                                <!-- LISTA -->
                                <list>
                                    <field name="product_id"/>
                                    <field name="product_uom_qty"/>
                                    <field name="product_uom"/>
                                </list>
                                <!-- FORMULARIO DE LÍNEA -->
                                <form>
                                    <group>
                                        <field name="product_id"/>
                                        <field name="product_uom_qty"/>
                                        <field name="product_uom"/>
                                    </group>
                                </form>
                            </field>
                        </page>

                        <page string="Notas">
                            <field name="notes" placeholder="Observaciones relevantes…"/>
                        </page>
                    </notebook>
                </sheet>

                <!-- Chatter -->
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="activity_ids"        widget="mail_activity"/>
                    <field name="message_ids"         widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>
</odoo>
